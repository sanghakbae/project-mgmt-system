# ── 인증 (기존 Supabase 유지: 이메일/비밀번호) ─────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── 프로젝트 데이터 (Firebase Firestore) ───────────────────────
# Firebase 콘솔 → 프로젝트 설정 → '내 앱'(웹) → SDK 설정/구성에서 복사
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# ── 첨부파일 (Cloudflare R2 presign Worker) ────────────────────
# worker/ 를 배포한 뒤의 Worker URL. 미설정 시 dataURL(base64) 폴백으로 동작.
VITE_R2_WORKER_URL=https://pms-r2-presign.your-subdomain.workers.dev
